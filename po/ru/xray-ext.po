msgid "Queued…"
msgstr "В очереди…"

msgid "Waiting for WAN…"
msgstr "Жду WAN…"

msgid "Refreshing…"
msgstr "Обновляю…"

msgid "Refresh now"
msgstr "Обновить сейчас"

msgid "Ready to start. No update has been requested yet."
msgstr "Готово к запуску. Обновление ещё не запрашивалось."

msgid "Request accepted, waiting for execution…"
msgstr "Запрос принят, ожидание выполнения…"

msgid "WAN is unavailable. The request is waiting for the connection to be restored."
msgstr "WAN недоступен. Запрос ждёт восстановления соединения."

msgid "Subscription update: processed %d of %d; successful: %d, failed: %d."
msgstr "Обновление подписок: обработано %d из %d; успешно: %d, ошибок: %d."

msgid "Subscription update is in progress. Waiting for result data…"
msgstr "Выполняется обновление подписок. Ожидаем данные о результате…"

msgid "There are no enabled subscriptions to update."
msgstr "Нет включённых подписок для обновления."

msgid "Update completed: processed %d of %d; successful: %d, failed: %d."
msgstr "Обновление завершено: обработано %d из %d; успешно: %d, ошибок: %d."

msgid "Update completed with errors: processed %d of %d; successful: %d, failed: %d."
msgstr "Обновление завершено с ошибками: обработано %d из %d; успешно: %d, ошибок: %d."

msgid "Unknown update status."
msgstr "Неизвестное состояние обновления."

msgid "Completed: %s."
msgstr "Завершено: %s."

msgid "The request has been sent, but status polling is temporarily unavailable. The daemon may be busy with network processing; waiting for completion and automatically retrying…"
msgstr "Запрос отправлен, но опрос состояния временно не отвечает. Возможно, демон занят сетевой обработкой; ждём итог и повторяем проверку автоматически…"

msgid "Failed to read daemon status. Retrying automatically; if the error persists, check the xray_extd.status ACL and the connection to rpcd."
msgstr "Не удалось прочитать состояние демона. Повторяем проверку; если ошибка повторяется, проверьте ACL xray_extd.status и соединение с rpcd."

msgid "Sending…"
msgstr "Отправляем…"

msgid "Sending request to daemon…"
msgstr "Отправляем запрос демону…"

msgid "An update is already in progress. Connecting to its current status…"
msgstr "Обновление уже выполняется. Подключаемся к его текущему состоянию…"

msgid "The daemon did not accept the update request."
msgstr "Демон не принял запрос на обновление."

msgid "Failed to send the request. Check the xray_extd.refresh ACL and the connection to rpcd."
msgstr "Не удалось отправить запрос. Проверьте ACL xray_extd.refresh и соединение с rpcd."

