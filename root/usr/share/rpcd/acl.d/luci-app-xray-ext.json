{
    "luci-app-xray-ext": {
        "description": "Xray Extender",

        "read": {
            "uci": [
                "xray_ext",
                "xray_core"
            ],
	"ubus": {
	    "xray_extd": [
	        "status",
	        "outbounds",
	        "remove_outbound",
		"balancer_info"
	    ]
	}
        },

        "write": {
            "uci": [
                "xray_ext",
                "xray_core"
            ],

            "ubus": {
                "file": [
                    "*"
                ],
		"xray_extd": [
		    "refresh",
		    "add_outbound"
		]
            },

            "file": {
                "/usr/bin/xray": [
                    "exec"
                ],
                "/bin/sh": [
                    "exec"
                ],
                "/bin/cat": [
                    "exec"
                ]
            }
        }
    }
}